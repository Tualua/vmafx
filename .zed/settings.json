{

  "tab_size": 4,
  "hard_tabs": false,
  "line_ending": "enforce_lf",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "preferred_line_length": 100,
  "show_wrap_guides": true,
  "soft_wrap": "preferred_line_length",

  "file_scan_exclusions": [
    ".git",
    "build",
    "build-san",
    "build-cuda",
    "build-sycl",
    "build-all",
    "subprojects",
    ".venv",
    "node_modules",
    "**/*.yuv",
    "**/*.onnx",
    "**/*.pkl",
    "**/*.parquet"
  ],

  "file_types": {
    "C++": ["cu", "cuh", "hip", "metal", "mm"],
    "GLSL": ["comp", "vert", "frag", "glsl"],
    "Python": ["meson.build", "meson_options.txt"]
  },

  "languages": {
    "C": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "C++": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Python": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": [
        {
          "external": {
            "command": ".venv/bin/ruff",
            "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
          }
        }
      ]
    },
    "Shell Script": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": ".venv/bin/shfmt",
          "arguments": ["-i", "2", "-ci", "-"]
        }
      }
    },
    "TOML": { "tab_size": 2 },
    "YAML": { "tab_size": 2 },
    "JSON": { "tab_size": 2 },
    "Markdown": { "tab_size": 2, "soft_wrap": "preferred_line_length" }
  },

  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--compile-commands-dir=build",
          "--background-index",
          "--clang-tidy",
          "--clang-tidy-checks=-*,bugprone-*,cert-*,clang-analyzer-*,performance-*,portability-*",
          "--header-insertion=never",
          "--completion-style=detailed",
          "--function-arg-placeholders=true",
          "--pch-storage=memory",
          "-j=8"
        ]
      },
      "initialization_options": {
        "fallbackFlags": [
          "-std=c11",
          "-I./libvmaf/include",
          "-I./libvmaf/src"
        ]
      }
    },
    "pyright": {
      "initialization_options": {
        "python": {
          "analysis": {
            "typeCheckingMode": "basic"
          }
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "organizeImports": true
        }
      }
    }
  },

  "edit_predictions": {
    "disabled_globs": [
      "build/**",
      "build-*/**",
      "subprojects/**",
      "python/test/resource/**",
      "python/vmaf/resource/**",
      "python/vmaf/matlab/**",
      ".workingdir/**",
      ".workingdir2/**",
      ".corpus/**",
      "model/**",
      "**/*.yuv",
      "**/*.onnx",
      "**/*.onnx.data",
      "**/*.pkl",
      "**/*.parquet",
      "**/*.bin"
    ]
  },

  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_model": "claude-sonnet-4-5"
    },
    "codex-acp": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    }
  },

  "context_servers": {
    "vmaf-mcp": {
      "source": "custom",
      "command": "docker",
      "args": ["exec", "-i", "vmaf-dev-mcp", "vmaf-mcp"]
    }
  },

  "agent": {
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5"
    },
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5"
    },
    "commit_message_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5"
    },
    "thread_summary_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5"
    },
    "subagent_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5"
    },
    "play_sound_when_agent_done": "when_hidden",
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "mcp:vmaf-mcp:list_.*":      { "always_allow": true },
        "mcp:vmaf-mcp:describe_.*":  { "always_allow": true },
        "mcp:vmaf-mcp:vmaf_(score|score_encoded|version)": { "always_allow": true },
        "mcp:vmaf-mcp:probe_backend": { "always_allow": true },
        "mcp:vmaf-mcp:compare_models": { "always_allow": true },
        "mcp:vmaf-mcp:run_.*":       { "always_confirm": true },
        "mcp:vmaf-mcp:eval_.*":      { "always_confirm": true }
      }
    }
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
