{
  "name": "vmafx/vmafx",
  "build": {
    "dockerfile": "Dockerfile.praetor",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/nix:1": {},
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "customizations": {
    "praetor": {
      "bootstrap": {
        "version": 1,
        "state": "source-bundle",
        "builderImage": "docker.io/library/golang@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414",
        "baseImage": "ghcr.io/vmafx/vmafx-dev-mcp@sha256:3956ebc9342a75cc0120804cee37144fff402dc1bab83849c68bf73a2cd6c9cc",
        "sourceSHA256": "sha256:26a7135085d4131b75e9f7e520ed66a158b48b6882b63667fe4eee0b71dcf40d",
        "archiveSHA256": "sha256:6cf6b00736d8c40595aaedcb8c86f42dee3dbda09e17f9105098ea0da26a1b41",
        "archiveParts": 6,
        "dockerfileSHA256": "sha256:35f242062d43e0292a2cc5abcb37192754cf8cb46ea385b2825e4a31e92ecad7"
      }
    },
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "aquasecurity.trivy-vulnerability-scanner",
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "github.copilot",
        "llvm-vs-code-extensions.vscode-clangd",
        "mesonbuild.mesonbuild",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "clangd.arguments": [
          "--header-insertion=never"
        ],
        "clangd.path": "clangd",
        "editor.formatOnSave": true,
        "security.workspace.trust.enabled": true
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "export PATH=\"/usr/local/bin:$PATH\"; /usr/local/bin/praetorctl compile-context && /usr/bin/make verify-all"
}
