{
 "comment": "Images published for v1.0.0-rc.1 and v1.0.0-rc.2 before the licensing rules of ADR-1513, and what happens to each (ADR-1578). `keep` images get notices on their release page and a <tag>-source companion from .github/workflows/published-rc-licence-companions.yml; `withdrawn` images are deleted from GHCR. scans/<release>/<build>.json are the licence scans of the files the release tag's build compiles into the shipped programs (`ninja_targets`: vmaf and the libvmaf it links), made by `scripts/release/published_rc_companion.py scan`.",
 "schema_version": 1,
 "builds": {
  "cpu": {
   "options": [
    "--buildtype=release",
    "--strip",
    "-Denable_cuda=false",
    "-Denable_sycl=false",
    "-Denable_dnn=disabled",
    "-Denable_avx512=true",
    "-Denable_tests=false"
   ]
  },
  "cuda": {
   "options": [
    "--buildtype=release",
    "--strip",
    "-Denable_cuda=true",
    "-Denable_nvcc=true",
    "-Denable_sycl=false",
    "-Denable_dnn=disabled",
    "-Dc_std=c2x",
    "-Dcpp_std=c++23",
    "-Denable_avx512=true"
   ],
   "needs": "nvcc on PATH"
  },
  "sycl": {
   "options": [
    "--buildtype=release",
    "--strip",
    "-Denable_cuda=false",
    "-Denable_sycl=true",
    "-Denable_dnn=disabled",
    "-Db_lto=false",
    "-Dc_std=c2x",
    "-Denable_avx512=true",
    "-Dsycl_icpx_aot_targets="
   ],
   "env": {
    "CC": "icx",
    "CXX": "icpx"
   },
   "needs": "icx and icpx on PATH (source /opt/intel/oneapi/setvars.sh)"
  },
  "go-server": {
   "from": "cpu",
   "go_packages": [
    "./cmd/vmafx-server"
   ],
   "needs": "go on PATH"
  },
  "operator": {
   "go_packages": [
    "./cmd/vmafx-operator"
   ],
   "needs": "go on PATH"
  }
 },
