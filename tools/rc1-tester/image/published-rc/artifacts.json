 "withdrawal_reasons": {
  "rocm": "The image was the whole rocm/dev-ubuntu-26.04:10.0.0-full development image. It redistributed librocprof-trace-decoder.so, a binary-only AMD library whose licence (AMD Software End User License Agreement 3.2) forbids distributing it, and ROCgdb (GPL-3.0-or-later) without its source.",
  "node": "Its FFmpeg was configured with --enable-nonfree, which makes the build declare itself not legally redistributable, and it shipped GPL and LGPL libraries, and an rclone with an LGPL-3.0 module, without their source or notices."
 },
 "ninja_targets": [
  "tools/vmaf"
 ],
 "pypi_yank_reason": "Wrong licence metadata: the files are EUPL-1.2, the metadata says BSD-2-Clause-Patent.",
 "deleted_packages": [
  {
   "package": "ghcr.io/vmafx/vmafx-node",
   "date": "2026-10-04",
   "note": "Every version of the package came from the --enable-nonfree recipe, so the whole package was deleted. A later vmafx-node image is published into a new package, which starts private until it is made public."
  }
 ],
 "withdrawn_on": "2026-10-04"
}
